{
  "name": "AxhubMake",
  "version": "0.3.3",
  "private": true,
  "description": "Axhub Make（AI 辅助生成原型工具）",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/network-interfaces-shim.mjs ./node_modules/vite/bin/vite.js",
    "start": "node --import ./scripts/network-interfaces-shim.mjs ./node_modules/vite/bin/vite.js",
    "build": "node scripts/scan-entries.js && node scripts/build-all.js && node scripts/generate-dist-html.js",
    "preview": "node --import ./scripts/network-interfaces-shim.mjs ./node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check-ready": "node scripts/check-app-ready.mjs",
    "check:deqing-indicators": "node scripts/check-deqing-indicator-hardcode.mjs && vitest --run tests/deqing-auxiliary-indicator-flow.test.ts tests/deqing-indicator-readiness-matrix.test.ts tests/deqing-indicator-persistence.test.ts tests/deqing-indicator-code-generator.test.ts tests/deqing-scoring-rule-mode.invariant.test.ts tests/deqing-composite-aggregate-score-rules.test.ts tests/deqing-composite-point-type-applicability.test.ts tests/deqing-create-wizard-value-type.test.ts tests/deqing-numeric-match-label.test.ts tests/deqing-point-survey-visibility.test.ts tests/deqing-auxiliary-numeric-branch.test.ts tests/deqing-numeric-scoring-single-path.test.ts tests/deqing-seed-ratings-smoke.test.ts tests/deqing-condition-field-label.test.ts tests/deqing-wizard-auxiliary-condition-display.test.ts tests/deqing-conditional-match-values-exclusive.test.ts tests/deqing-conditional-scoring-flow.test.ts",
    "check:deqing-scoring-mode": "vitest --run tests/deqing-scoring-rule-mode.invariant.test.ts tests/deqing-composite-aggregate-score-rules.test.ts tests/deqing-composite-point-type-applicability.test.ts",
    "sync:skills": "node scripts/sync-third-party-skills.mjs"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "echarts": "^6.0.0",
    "execa": "^9.6.1",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^5.23.0",
    "postcss": "^8.4.47",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.16",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "formidable": "^3.5.4",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.1",
    "jspdf": "^3.0.4",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "shpjs": "^6.2.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  }
}
